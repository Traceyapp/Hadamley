{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hadamley",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "hadamley-3101",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3101"
      ],
      "port": 3101
    },
    {
      "name": "hadamley-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "HADAMLEY_STORE=file",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "hadamley-prod-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export HADAMLEY_STORE=file NEXT_DIST_DIR=.next-build && npx next build && npx next start -H 127.0.0.1 -p 3102"
      ],
      "port": 3102,
      "url": "http://127.0.0.1:3102"
    }
  ]
}